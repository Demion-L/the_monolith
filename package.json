{
  "name": "@latysh-development/monolith",
  "version": "0.1.0-alpha.0",
  "description": "MONOLITH — portable project knowledge and governance toolkit for AI-assisted development",
  "author": "Dmytro Latysh",
  "license": "MIT",
  "homepage": "https://github.com/Demion-L/the_monolith#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demion-L/the_monolith.git"
  },
  "bugs": {
    "url": "https://github.com/Demion-L/the_monolith/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "bin": {
    "monolith": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "dogfood-graph": "node dist/scripts/dogfood-graph.js",
    "prepare": "npm run build",
    "dev:api": "node dist/scripts/dev-api.js",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck:ui": "vue-tsc -p ui/tsconfig.json --noEmit",
    "build:ui": "vite build --config ui/vite.config.ts",
    "test:ui": "vitest run --config ui/vitest.config.ts"
  },
  "keywords": [
    "monolith",
    "knowledge-toolkit",
    "ai-assistant",
    "enforcement",
    "protocol"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5",
    "@vue/test-utils": "^2",
    "jsdom": "^25",
    "typescript": "^5.6.3",
    "vite": "^6",
    "vitest": "^2.0.0",
    "vue": "^3.5",
    "vue-tsc": "^2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
